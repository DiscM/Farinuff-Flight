[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/frontend/command_deck.gd" id="1_deck"]
[ext_resource type="Theme" path="res://ui/themes/farinuff_frontend_theme.tres" id="2_theme"]

[node name="CommandDeck" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_deck")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 32

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Kicker" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "EXPEDITION  ·  THE RETURN SIGNAL"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.17, 0.95, 1, 1)

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "FARINUFF FLIGHT"
autowrap_mode = 2
theme_override_font_sizes/font_size = 38
theme_override_colors/font_color = Color(1, 0.86, 0.26, 1)
theme_override_colors/font_outline_color = Color(0.22, 0.07, 0.43, 1)
theme_override_constants/outline_size = 3

[node name="ObjectiveLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 24)
text = "Return the signal to the last charted relay"
autowrap_mode = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.9, 0.98, 1, 1)

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2

[node name="LaunchButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 52)
text = "PLAN EXPEDITION"
alignment = 1
theme_override_font_sizes/font_size = 22
accessibility_name = "Plan Expedition"
accessibility_description = "Open the Expedition chart before choosing a hull and launching."

[node name="Spacer2" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 6)
layout_mode = 2

[node name="Sections" type="HFlowContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="MapButton" type="Button" parent="Margin/VBox/Sections"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "EXPEDITION MAP"
accessibility_name = "Open Expedition Map"
accessibility_description = "Plan the return route across the relay network."

[node name="HangarButton" type="Button" parent="Margin/VBox/Sections"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "HANGAR"
accessibility_name = "Open Hangar"
accessibility_description = "Spend salvage and adjust the loadout."

[node name="SettingsButton" type="Button" parent="Margin/VBox/Sections"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
text = "SETTINGS"
accessibility_name = "Open Settings"
accessibility_description = "Adjust audio, display, and accessibility options."

[node name="DiscoveryLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
text = "LATEST DISCOVERY  ·  No recovered fragments yet — signal source unknown."
autowrap_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.25, 0.56, 1)

[node name="VersionLabel" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "BUILD 0.5.0  ·  SWALLOWTAIL  ·  SIGNAL LOCKED"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.55, 0.63, 0.78, 1)