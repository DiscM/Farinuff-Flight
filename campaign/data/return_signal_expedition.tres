[resource]
script = ExtResource("1_campaign")
id = &"return_signal_expedition"
display_name = "The Return Signal Expedition"
premise_key = &"campaign.premise.return_signal"
sector_names = PackedStringArray("The Far Reach", "The Broken Perimeter", "Tempest Reach", "The Quiet Core")
start_node_id = &"far_reach"
final_node_id = &"quiet_core"
nodes = [ExtResource("6_far_node"), ExtResource("7_iron_node"), ExtResource("8_ghost_node"), ExtResource("9_veil_node"), ExtResource("10_echo_node"), ExtResource("11_core_node")]
route_profiles = [ExtResource("2_iron_profile"), ExtResource("3_ghost_profile"), ExtResource("4_veil_profile"), ExtResource("5_echo_profile")]
boss_milestones = [ExtResource("12_assault_boss"), ExtResource("13_bulwark_boss"), ExtResource("14_tempest_boss"), ExtResource("15_core_boss"), ExtResource("16_harbinger_boss")]
story_beats = [ExtResource("17_far_briefing"), ExtResource("18_far_debrief"), ExtResource("19_broken_briefing"), ExtResource("20_broken_debrief"), ExtResource("21_tempest_briefing"), ExtResource("22_tempest_debrief"), ExtResource("23_core_briefing"), ExtResource("24_victory"), ExtResource("25_iron_fragment"), ExtResource("26_ghost_fragment"), ExtResource("27_veil_fragment"), ExtResource("28_echo_fragment")]
