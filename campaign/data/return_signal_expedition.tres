[ext_resource type="Resource" path="res://campaign/data/routes/echo_field.tres" id="5_echo_profile"]
[ext_resource type="Resource" path="res://campaign/data/nodes/far_reach.tres" id="6_far_node"]
[ext_resource type="Resource" path="res://campaign/data/nodes/iron_wake.tres" id="7_iron_node"]
[ext_resource type="Resource" path="res://campaign/data/nodes/ghost_lanes.tres" id="8_ghost_node"]
[ext_resource type="Resource" path="res://campaign/data/nodes/tempest_veil.tres" id="9_veil_node"]
