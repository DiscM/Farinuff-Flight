[ext_resource type="Resource" path="res://campaign/data/bosses/bulwark.tres" id="13_bulwark_boss"]
[ext_resource type="Resource" path="res://campaign/data/bosses/tempest.tres" id="14_tempest_boss"]
[ext_resource type="Resource" path="res://campaign/data/bosses/core.tres" id="15_core_boss"]
[ext_resource type="Resource" path="res://campaign/data/bosses/harbinger.tres" id="16_harbinger_boss"]
[ext_resource type="Resource" path="res://campaign/data/story/far_reach_briefing.tres" id="17_far_briefing"]
[ext_resource type="Resource" path="res://campaign/data/story/far_reach_debrief.tres" id="18_far_debrief"]
[ext_resource type="Resource" path="res://campaign/data/story/broken_perimeter_briefing.tres" id="19_broken_briefing"]
[ext_resource type="Resource" path="res://campaign/data/story/broken_perimeter_debrief.tres" id="20_broken_debrief"]
