# Godot 4+ specific ignores
.godot/
/android/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Exported builds (keep export_presets.cfg itself tracked)
*.exe
*.pck
*.zip
builds/

# System/tool-specific
.DS_Store

# Visual mockups and generated previews (keep local copies)
/mockups*/
/design/mockups/
/assets/models/mockups/
# 3D models live in assets/models/ships/ and remain tracked.

# Python cache from the tools/ generators
__pycache__/

# Local Codex/Godot interaction server generated by the desktop tooling
mcp_interaction_server.gd
mcp_interaction_server.gd.uid

# Local Blender checkpoints and transient asset-build logs
/assets/models/wayfarer_crescent/source/archive/
/design/home-base/blender-crescent/*.log
